# Optional environment variables for the Agentic OS web server.
# Every variable has a safe default — the app runs with no .env file at
# all, and local mode needs no secrets, API keys, or credentials.
# Hosted deployments may set the database, authentication, and model
# credentials below. Keep every one of them server-side: none is ever
# sent to the browser, and this file must contain placeholders only.

# Comma-separated list of origins allowed to call the API from a browser.
# Only needed when the frontend dev server runs on a non-default port.
AGENTIC_OS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Alternative configuration file for the server (used by the e2e tests to
# avoid touching the real data/memory.json).
# AGENTIC_OS_CONFIG=frontend/e2e/.tmp/config.json

# Where approved reports are published, as Markdown an owner opens in
# Obsidian (ADR 0044). `~` is expanded, and a relative path resolves
# against the repository, so the server, the worker and the MCP server
# all publish to one folder. Unset, reports go to the repository's own
# vault/. Set it here rather than in config.json: config.json is tracked
# in a public repository and your vault path holds your user name.
# AGENTIC_OS_VAULT_DIR=~/Documents/Obsidian Vault

# Approved Markdown publication: database (no filesystem writes) or vault
# (Obsidian files plus SQL notes). VERCEL=1 defaults to database; other
# hosts default to vault. Both retain human review and owner permissions.
# AGENTIC_OS_PUBLISH_TARGET=database

# Path to a pre-installed Chromium for Playwright e2e tests, when browser
# downloads are unavailable.
# PLAYWRIGHT_EXECUTABLE_PATH=/opt/pw-browsers/chromium

# Hosted-mode database (server-side ONLY). When set, runs/tasks/approvals/
# artifacts persist to PostgreSQL instead of the local SQLite file. For
# Supabase use the session pooler string from the dashboard (Connect →
# Session pooler), e.g.:
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Managed authentication (server-side ONLY). With none of these set the
# app runs in labelled local mode: one local owner, no login. Setting
# AGENTIC_OS_ENV=production or AGENTIC_OS_REQUIRE_AUTH=1 WITHOUT a
# provider makes startup fail closed rather than serve data openly.
# AGENTIC_OS_ENV=production
# Shared-secret tokens (Supabase legacy JWT secret, HS256):
# SUPABASE_JWT_SECRET=your-project-jwt-secret
# or OIDC/JWKS verification (RS256/ES256):
# AGENTIC_OS_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# AGENTIC_OS_JWT_AUDIENCE=authenticated
# AGENTIC_OS_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
# Browser sign-in (publishable values only — safe to expose):
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=your-publishable-anon-key
# Per-caller write rate limit (default 600 per 60s, sized above the
# analytics run engine's own ~3 writes/second cadence):
# AGENTIC_OS_RATE_LIMIT=600
# AGENTIC_OS_RATE_WINDOW=60
# Role for authenticated users whose token carries no role claim:
# AGENTIC_OS_DEFAULT_ROLE=viewer
# Live sources (ADR 0034): when set, the only hosts a connector may fetch
# from, comma-separated. Unset allows any public https host.
# AGENTIC_OS_CONNECTOR_HOSTS=data.example.com,files.example.org
# Seconds "Refresh now" waits after the last fetch of a source (default 60):
# AGENTIC_OS_CONNECTOR_COOLDOWN=60
# Never set AGENTIC_OS_CONNECTOR_FIXTURES outside the end-to-end tests.

# Optional narrator. The model only phrases already-verified facts — it
# never sees the dataset and never produces a number. With none of these
# set, a deterministic template is used and the app is fully functional
# offline. All are server-side ONLY: never expose one to the browser, and
# rotate any key that was ever shared in chat.
#
# Priority: ollama > anthropic > groq > Vercel AI Gateway. Ollama comes first because it is
# the only option where nothing leaves your machine.
#
# 1. Local model via Ollama (no key, no account):
#      ollama pull qwen3:4b-instruct-2507-q4_K_M
#    If Ollama is not running, start `ollama serve` in a separate terminal.
# OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_THINK=0
# OLLAMA_CONTEXT_LENGTH=4096
# OLLAMA_NUM_THREAD=6
# OLLAMA_TEMPERATURE=0.2
# AGENTIC_OS_MODEL_TIMEOUT_SECONDS=60
# Optional hosted AI Gateway: set a current provider/model ID explicitly.
# Vercel deployments use their injected VERCEL_OIDC_TOKEN; external hosts
# may supply AI_GATEWAY_API_KEY through a secret store. Never copy tokens here.
# AI_GATEWAY_MODEL=provider/model-from-the-live-catalog
# AI_GATEWAY_API_KEY=
#    Reasoning models (qwen3, deepseek-r1) think inside <think> tags before
#    answering; that scratchpad is stripped and never reaches a report, and
#    local models get a larger token budget so thinking does not eat the
#    whole reply. Ollama must be reachable from the SERVER: a model on your
#    laptop is not visible to a hosted deployment.
#
# 2. Claude:
# ANTHROPIC_API_KEY=your-rotated-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-5
#
# Hosted open-source models (for a deployment that cannot reach a laptop):
# point OLLAMA_HOST at a hosted Ollama-compatible endpoint and set its key,
# or use Groq below. A non-local Ollama host is treated as hosted.
# OLLAMA_HOST=https://your-hosted-ollama-endpoint
# OLLAMA_API_KEY=your-rotated-key-here
#
# 3. OpenAI (both are required; no OpenAI model is chosen for you):
# OPENAI_API_KEY=your-rotated-key-here
# OPENAI_MODEL=a-current-model-id-from-your-openai-account
#
# 4. Groq:
# GROQ_API_KEY=your-rotated-key-here
# GROQ_MODEL=openai/gpt-oss-120b
#
# With two hosted providers set, a failed call to the first is retried once
# on the second before the built-in narrator answers.
#
# Free hosted open-source models (docs/FREE_OPEN_MODELS.md); each needs key + model id:
# OPENROUTER_API_KEY=...   OPENROUTER_MODEL=a-current-free-model-id
# NVIDIA_API_KEY=...       NVIDIA_MODEL=a-current-model-id
# MISTRAL_API_KEY=...      MISTRAL_MODEL=a-current-model-id
# CEREBRAS_API_KEY=...     CEREBRAS_MODEL=a-current-model-id
#
# Which provider serves each AI task (unmapped tasks use the default):
# AGENTIC_OS_TASK_MODELS=narration=groq,chat=groq,hermes=openrouter,agents=ollama,consultants=openrouter+nvidia
# "provider:model" gives a role its own model, e.g. two local Ollama models:
# AGENTIC_OS_TASK_MODELS=hermes=ollama:hermes3,agents=ollama:qwen3,consultants=anthropic+openai
# One installed model for all local roles on a memory-constrained CPU:
# OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
# OLLAMA_THINK=0
# AGENTIC_OS_TASK_MODELS=narration=ollama,chat=ollama,hermes=ollama,agents=ollama,consultants=ollama
# Distinct role prompts share the same model; this is not independent provider review.
#
# A role with no model is played by the built-in writer (rules over the
# verified findings, no model; docs/adr/2026-10-22-built-in-roles.md).
# AGENTIC_OS_BUILT_IN_ROLES=0   # switch that off: no model, no role
#
# Model roles (docs/adr/2026-10-21-model-roles-hermes-agents-consultants.md).
# Each names a provider configured above, optionally as provider:model;
# leave unset for none.
# AGENTIC_OS_HERMES_MODEL=anthropic        # orchestrator: plan and approver's brief
# AGENTIC_OS_AGENT_MODEL=ollama            # each agent's note on its own findings
# AGENTIC_OS_CONSULTANTS=anthropic,openai  # independent review before the report

# Per-tenant quotas. Defaults (200 runs/day, 100 datasets, 50 MB per
# owner) exist to stop a runaway loop, not to ration ordinary use. A
# malformed value falls back to the default; 0 is honoured as a real stop.
# AGENTIC_OS_QUOTA_RUNS_PER_DAY=200
# AGENTIC_OS_QUOTA_DATASETS=100
# AGENTIC_OS_QUOTA_DATASET_BYTES=50000000

# Optional: choose the narrator per report instead of by the fixed
# priority order above (ADR 0017). Anything with a
# route_single({"query": ...}) -> {"model_name": ...} method works,
# including every router in github.com/ulab-uiuc/LLMRouter. LLMRouter is
# NOT installed by requirements.txt — its routers bring torch and CUDA
# wheels (5.3 GB measured); install it separately if you want them.
# A router that cannot be loaded leaves narration exactly as it was and
# reports the problem in /api/health.
# AGENTIC_OS_ROUTER=llmrouter.models.smallest_llm.router.SmallestLLM
# AGENTIC_OS_ROUTER_CONFIG=router.yaml

# Optional: custom stages (ADR 0020). Comma-separated dotted paths to
# classes with role, title, after and run(ctx); a stage that needs
# options is registered in config.json instead ("stages": [{"path": …,
# "options": {…}}]). AGENTIC_OS_STAGES_PATH makes plain folders
# importable (os.pathsep-separated). A stage that fails to load leaves
# the pipeline as it was and is reported in /api/health and /api/pipelines.
# AGENTIC_OS_STAGES=examples.stages.target_attainment.TargetAttainment
# AGENTIC_OS_STAGES_PATH=./plugins

# Optional: an agent runtime behind the chat (ADR 0021) — a class with
# run(message, tools, context). It gets the sentences the rules cannot
# place, calls tools only through the tool box (no deletions, eight calls
# per message), and its closing line is labelled on screen. Options go in
# config.json ("agent_runtime": {"path": …, "options": {…}}).
# AGENTIC_OS_AGENT_RUNTIME=examples.runtimes.langgraph_runtime.LangGraphRuntime

# Optional local Whisper transcription (ADR 0055). Install the optional
# requirements and download weights explicitly with scripts/local_runtime.py
# install --voice. HTTP requests never download models. Directory must be
# absolute and contain the converted multilingual model/tokenizer files.
# AGENTIC_OS_WHISPER_ENABLED=1
# AGENTIC_OS_WHISPER_MODEL_DIR=/absolute/path/to/faster-whisper-small
